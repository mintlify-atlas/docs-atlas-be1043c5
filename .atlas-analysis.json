  "keyFeatures": [
    "Identity management with login, registration, MFA, passwordless, and social sign-in flows",
    "OAuth2 and OpenID Connect provider with 15+ IETF and OpenID standards support",
    "Relationship-based fine-grained access control (Zanzibar-inspired permissions)",
    "Zero-trust identity and access proxy (Oathkeeper)",
    "SAML enterprise SSO integration via Ory Polis",
    "Headless APIs with bring-your-own-UI support",
    "Fully open-source core under Apache 2.0 license",
    "Ory Network: planet-scale managed cloud service"
  ],
  "publicApiSurface": [
    "GET /identities — list identities",
    "POST /identities — create identity",
    "GET /sessions/whoami — check active session",
    "POST /self-service/login — initiate login flow",
    "POST /self-service/registration — initiate registration flow",
    "GET /oauth2/auth — OAuth2 authorization endpoint",
    "POST /oauth2/token — OAuth2 token endpoint",
    "GET /userinfo — OpenID Connect userinfo endpoint",
    "POST /relation-tuples — create permission relation",
    "GET /relation-tuples/check — check permission",
    "GET /.well-known/openid-configuration — OIDC discovery endpoint",
    "POST /admin/oauth2/clients — create OAuth2 client"
  ]
